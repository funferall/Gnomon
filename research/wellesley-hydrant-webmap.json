            "name": "expr0",
            "title": "Nearest Address",
            "expression": "var num = $feature.StreetNumber;\r\nvar street = $feature.StreetName;\r\n\r\nif ((IsEmpty(num)) && (IsEmpty(street))) {\r\n  return null;\r\n} else if ((IsEmpty(num)) && (!IsEmpty(street))) {\r\n  return street;\r\n} else if ((!IsEmpty(num)) && (IsEmpty(street))) {\r\n  return null;\r\n} else {\r\n  return num + \" \" + street\r\n}",
